# python
__pycache__/
*.pyc
*.pyo

# virtualenvs
.venv/
venv/

# editor / OS
.DS_Store
*.swp
*.bak
*.bak-*

# Tool OUTPUT. Every tool here writes its results into the directory it runs
# in or next to itself; none of it is source.
*.zip
*.tsv
ssd_sample_check_*.csv
camera_fingerprints.csv
board_*.txt

# Recordings / takes dropped in for a look. They belong on an SSD, not in git.
recordings/
20[0-9][0-9][01][0-9][0-3][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]/

# Machine-local state a tool reads back (kept on disk, never committed)
fleet/opm-name/board_registry.json
fleet/opm-name/board_registry.json.tmp

# StarCap QC's per-board reports: laptop-only by design (one JSON per QC run)
fleet/starcap-qc/reports/
fleet/starcap-qc/.delivery_cache/
camera/camfw/fwidentapp/.last-run.json
camera/camrig/presets.json
camera/camrig/.venv/

# The five big flashing images (~30 GB) live in the private bucket, not git.
# flashing/IMAGES.sha256 is the manifest; flashing/fetch_images.sh restores them.
flashing/nanopi/emmc/nanopiIMAGE/*/rootfs.img
flashing/nanopi/emmc/nanopiIMAGE/*/userdata.img
flashing/nanopi/sd/*.img.zip
flashing/opi/emmc/*.img
flashing/opi/sd/*.img.gz
*.part

# LibreOffice lock files
.~lock.*#
